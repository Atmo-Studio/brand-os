    "easing": {
      "$type": "cubicBezier",
      "enter": {
        "$value": [
          0.2,
          0,
          0,
          1
        ],
        "$description": "Decelerates. For anything arriving."
      },
      "exit": {
        "$value": [
          0.4,
          0,
          1,
          1
        ],
        "$description": "Accelerates. For anything leaving."
      },
      "standard": {
        "$value": [
          0.2,
          0,
          0.2,
          1
        ],
        "$description": "Eases both ways. For movement that starts and ends on screen."
      },
      "linear": {
        "$value": [
          0,
          0,
          1,
          1
        ],
        "$description": "No curve. For a change of color, where position never moves."
      }
