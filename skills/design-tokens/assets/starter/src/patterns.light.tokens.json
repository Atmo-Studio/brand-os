{
  "patterns": {
    "color": {
      "$type": "color",
      "bg": {
        "page": {
          "$value": "{intent.color.neutral.50}"
        },
        "surface": {
          "$value": "{intent.color.neutral.100}"
        },
        "raised": {
          "$value": "{intent.color.neutral.50}"
        },
        "sunken": {
          "$value": "{intent.color.neutral.200}"
        },
        "inverse": {
          "$value": "{intent.color.neutral.900}"
        }
      },
      "text": {
        "primary": {
          "$value": "{intent.color.neutral.900}"
        },
        "secondary": {
          "$value": "{intent.color.neutral.700}"
        },
        "disabled": {
          "$value": "{intent.color.neutral.400}"
