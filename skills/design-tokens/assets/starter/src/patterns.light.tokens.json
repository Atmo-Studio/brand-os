          "lineHeight": "{brand.line-height.1}",
          "letterSpacing": "{brand.tracking.normal}"
        }
      },
      "body": {
        "$value": {
          "fontFamily": "{brand.font.family.sans}",
          "fontSize": "{brand.font-size.0}",
          "fontWeight": "{brand.font.weight.regular}",
          "lineHeight": "{brand.line-height.0}",
          "letterSpacing": "{brand.tracking.normal}"
        }
      },
      "body-s": {
        "$value": {
          "fontFamily": "{brand.font.family.sans}",
          "fontSize": "{brand.font-size.n1}",
          "fontWeight": "{brand.font.weight.regular}",
          "lineHeight": "{brand.line-height.n1}",
          "letterSpacing": "{brand.tracking.normal}"
        }
      },
      "label": {
        "$value": {
          "fontFamily": "{brand.font.family.sans}",
          "fontSize": "{brand.font-size.n1}",
          "fontWeight": "{brand.font.weight.medium}",
          "lineHeight": "{brand.line-height.n1}",
          "letterSpacing": "{brand.tracking.wide}"
        }
      },
      "caption": {
        "$value": {
          "fontFamily": "{brand.font.family.sans}",
          "fontSize": "{brand.font-size.n2}",
          "fontWeight": "{brand.font.weight.regular}",
          "lineHeight": "{brand.line-height.n2}",
          "letterSpacing": "{brand.tracking.wide}"
        }
      }
    },
    "motion": {
      "feedback": {
        "$type": "duration",
        "duration": {
          "$value": "{brand.duration.150}",
          "$extensions": {
            "brand-os": {
              "reduced-motion": "{brand.duration.150}"
            }
          }
        },
        "duration-exit": {
          "$value": "{brand.duration.100}",
          "$extensions": {
            "brand-os": {
              "reduced-motion": "{brand.duration.100}"
            }
          }
        }
      },
      "component": {
        "$type": "duration",
        "duration": {
          "$value": "{brand.duration.300}",
          "$extensions": {
            "brand-os": {
              "reduced-motion": "{brand.duration.0}"
            }
          }
        },
        "duration-exit": {
          "$value": "{brand.duration.200}",
          "$extensions": {
            "brand-os": {
              "reduced-motion": "{brand.duration.0}"
            }
          }
        }
      },
      "layout": {
        "$type": "duration",
        "duration": {
          "$value": "{brand.duration.500}",
          "$extensions": {
            "brand-os": {
              "reduced-motion": "{brand.duration.0}"
            }
          }
        },
        "duration-exit": {
          "$value": "{brand.duration.350}",
          "$extensions": {
            "brand-os": {
              "reduced-motion": "{brand.duration.0}"
            }
          }
        }
      },
      "easing": {
        "$type": "cubicBezier",
        "enter": {
          "$value": "{brand.easing.enter}"
        },
        "exit": {
          "$value": "{brand.easing.exit}"
        },
        "standard": {
          "$value": "{brand.easing.standard}"
        },
        "linear": {
          "$value": "{brand.easing.linear}"
        }
      }
    },
    "elevation": {
      "$type": "shadow",
      "raised": {
        "$value": "{brand.shadow.sm}"
      },
      "overlay": {
        "$value": "{brand.shadow.lg}"
      }
    }
