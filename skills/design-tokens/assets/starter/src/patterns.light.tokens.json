          "$value": "{intent.color.neutral.200}"
        },
        "default": {
          "$value": "{intent.color.neutral.500}"
        },
        "strong": {
          "$value": "{intent.color.neutral.900}"
        },
        "separator": {
          "$value": "{intent.color.neutral.200}"
        },
        "focus": {
          "$value": "{intent.color.accent.600}"
        }
      },
      "accent": {
        "bg-subtle": {
          "$value": "{intent.color.accent.100}"
        },
        "border": {
          "$value": "{intent.color.accent.300}"
        },
        "bg": {
          "$value": "{intent.color.accent.600}"
        },
        "bg-hover": {
          "$value": "{intent.color.accent.700}"
        },
        "bg-pressed": {
          "$value": "{intent.color.accent.800}"
        },
        "text": {
          "$value": "{intent.color.accent.700}"
        }
      },
      "action": {
        "bg": {
          "$value": "{intent.color.accent.600}"
        },
        "bg-hover": {
          "$value": "{intent.color.accent.700}"
        },
        "bg-pressed": {
          "$value": "{intent.color.accent.800}"
        },
        "bg-disabled": {
          "$value": "{intent.color.neutral.200}"
        },
        "secondary-bg-hover": {
          "$value": "{intent.color.neutral.200}"
        },
        "secondary-bg-pressed": {
          "$value": "{intent.color.neutral.300}"
        },
        "text": {
          "$value": "{intent.color.neutral.50}"
        },
        "text-disabled": {
          "$value": "{intent.color.neutral.500}"
        }
      },
      "$extensions": {
        "brand-os": {
          "starter": true
        }
      }
    },
    "$description": "Patterns: where each meaning is applied, for one theme. The only layer work references. A color role points at Intent; a group with no Intent (type, motion, elevation) points at Brand.",
    "type": {
      "$type": "typography",
      "display": {
        "$value": {
          "fontFamily": "{brand.font.family.sans}",
          "fontSize": "{brand.font-size.7}",
          "fontWeight": "{brand.font.weight.medium}",
          "lineHeight": "{brand.line-height.7}",
          "letterSpacing": "{brand.tracking.tight}"
        }
      },
      "heading": {
        "$value": {
          "fontFamily": "{brand.font.family.sans}",
          "fontSize": "{brand.font-size.5}",
          "fontWeight": "{brand.font.weight.medium}",
          "lineHeight": "{brand.line-height.5}",
          "letterSpacing": "{brand.tracking.tight}"
        }
      },
      "subheading": {
        "$value": {
          "fontFamily": "{brand.font.family.sans}",
          "fontSize": "{brand.font-size.3}",
          "fontWeight": "{brand.font.weight.medium}",
          "lineHeight": "{brand.line-height.3}",
          "letterSpacing": "{brand.tracking.snug}"
        }
      },
      "body-l": {
        "$value": {
          "fontFamily": "{brand.font.family.sans}",
          "fontSize": "{brand.font-size.1}",
